---
const glyphs = [
  { g: "{ }", l: "5%", t: "14%", s: 15, d: 30, dl: -6 },
  { g: "</>", l: "22%", t: "8%", s: 13, d: 36, dl: -18 },
  { g: "0x", l: "41%", t: "20%", s: 12, d: 28, dl: -11 },
  { g: "#", l: "63%", t: "11%", s: 18, d: 34, dl: -24 },
  { g: "git", l: "81%", t: "17%", s: 13, d: 31, dl: -3 },
  { g: "=>", l: "92%", t: "34%", s: 14, d: 38, dl: -16 },
  { g: "MIT", l: "9%", t: "42%", s: 12, d: 33, dl: -9 },
  { g: "[]", l: "29%", t: "55%", s: 16, d: 27, dl: -21 },
  { g: "fn", l: "48%", t: "38%", s: 13, d: 35, dl: -5 },
  { g: "&&", l: "70%", t: "48%", s: 15, d: 29, dl: -14 },
  { g: "cargo", l: "86%", t: "62%", s: 12, d: 37, dl: -27 },
  { g: "fork()", l: "14%", t: "72%", s: 12, d: 32, dl: -2 },
  { g: "sudo", l: "37%", t: "79%", s: 13, d: 34, dl: -19 },
  { g: "0b1", l: "58%", t: "70%", s: 12, d: 28, dl: -8 },
  { g: "/* */", l: "76%", t: "84%", s: 11, d: 36, dl: -23 },
  { g: "push", l: "94%", t: "90%", s: 12, d: 30, dl: -12 },
  { g: "~", l: "3%", t: "88%", s: 20, d: 33, dl: -15 },
  { g: "^", l: "52%", t: "93%", s: 18, d: 27, dl: -7 },
];
---
<div class="codefield" aria-hidden="true">
  {glyphs.map((x) => (
    <span style={`left:${x.l};top:${x.t};font-size:${x.s}px;--d:${x.d}s;--dl:${x.dl}s`}>{x.g}</span>
  ))}
</div>
