---
import { faqs } from "../data/site";
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<section class="sec"><div class="wrap">
  <div class="lab rv">Questions</div>
  <h2 data-split>Good to know.</h2>
  <div class="faq">
    {faqs.map((f) => (
      <details class="rv">
        <summary>{f.q}<span class="plus">+</span></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</div></section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
