---
import { socials } from "../data/site";
import register from "../data/register.json";
import Icon from "./Icon.astro";
const rec = (id: string) => (register.records as any)[id] || { state: "absent" };
const isStated = (r: any) => r && r.state === "stated";
const xR = rec("x"), ghR = rec("github");
---
<footer class="foot"><div class="wrap">
  <div>
    <a href="/" class="logo"><i></i>COIN CRAFT</a>
    <small>COIN CRAFT is a meme coin made for fun and community. It has no intrinsic value or expectation of financial return, and nothing here is financial advice. Exchange listings shown are targets and are not guaranteed. Always do your own research.</small>
  </div>
  <div class="links">
    <a href="https://getartcraft.com" target="_blank" rel="noopener">ArtCraft</a>
    <div class="socs">
      {isStated(xR) && xR.url
        ? <a class="soc" href={xR.url} target="_blank" rel="noopener" aria-label="X"><Icon name="x" size={15} /></a>
        : <span class="soc is-inert" aria-disabled="true" aria-label="X, pending"><Icon name="x" size={15} /></span>}
      {isStated(ghR) && ghR.url
        ? <a class="soc" href={ghR.url} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={17} /></a>
        : <span class="soc is-inert" aria-disabled="true" aria-label="GitHub, pending"><Icon name="github" size={17} /></span>}

    </div>
    <a class="totop" href="#top">Back to top <Icon name="arrow-up" size={14} /></a>
  </div>
</div>
<div class="wrap"><div class="mark" aria-hidden="true">COIN CRAFT</div></div>
</footer>