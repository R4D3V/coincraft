---
import "../styles/global.css";
import "@fontsource-variable/inter-tight";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CodeField from "../components/CodeField.astro";
const SITE = "COIN CRAFT";
const SITE_DESC = "COIN CRAFT is the meme coin gateway to open-source tools for artists on GitHub. Built by the ArtCraft team, owned by the community, free to fork forever.";
const {
  title,
  description = SITE_DESC,
  image = "/og.png",
} = Astro.props;
const fullTitle = title ? (title.includes(SITE) ? title : `${title} — ${SITE}`) : "COIN CRAFT — Open source, open creativity";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0b0b0c" />
  <script is:inline>document.documentElement.classList.add("js");</script>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <title>{fullTitle}</title>

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "COIN CRAFT",
      "url": "https://coincraft.cc/",
      "description": "COIN CRAFT is the meme coin gateway to open-source tools for artists on GitHub.",
      "publisher": {
        "@type": "Organization",
        "name": "COIN CRAFT",
        "url": "https://coincraft.cc/",
        "sameAs": ["https://github.com/storytold"]
      }
    }
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="progress" aria-hidden="true"><i id="progress"></i></div>
  <div class="glow"></div>
  <CodeField />
  <Nav />
  <main id="main"><slot /></main>
  <Footer />
  <script>import "../scripts/motion.ts";</script>
</body>
</html>
