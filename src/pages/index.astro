---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import Terminal from "../components/Terminal.astro";
import Icon from "../components/Icon.astro";
import { steps } from "../data/site";
import register from "../data/register.json";
const caRec = (register.records as any).ca || { state: "absent" };
const caStated = caRec.state === "stated" && caRec.value;
const caValue = caStated ? caRec.value : "";
const cards = [
  { href: "/gateway", k: "A", t: "Gateway", p: "Sixteen open-source apps from ArtCraft, one click from GitHub." },
  { href: "/ownership", k: "B", t: "Ownership", p: "No rent, no middlemen. Fork it, keep it, make it yours." },
  { href: "/roadmap", k: "C", t: "Roadmap", p: "From genesis to CEX listings and holder bounties." },
  { href: "/listings", k: "D", t: "Listings", p: "Binance, OKX and Bybit are our targets. Soon." },
];
---
<Base description="COIN CRAFT is the meme coin gateway to open-source tools for artists on GitHub. Owned by the community, free to fork forever.">
  <header class="hero" id="top">
    <svg class="git" viewBox="0 0 560 720" aria-hidden="true">
      <path d="M60 660 C 60 520 200 500 200 360 S 200 220 360 220 S 440 140 440 40" />
      <path d="M200 360 C 200 260 340 260 340 160" />
      <path d="M200 480 C 90 480 90 380 60 300" />
      <path d="M360 220 C 500 220 500 320 520 420" />
      <path d="M200 560 C 340 560 380 620 520 620" />
      <circle cx="60" cy="660" r="5" />
      <circle cx="130" cy="592" r="5" />
      <circle class="acc" cx="200" cy="480" r="5.5" />
      <circle cx="200" cy="360" r="5" />
      <circle class="acc" cx="340" cy="160" r="5" style="animation-delay:-1.2s" />
      <circle cx="360" cy="220" r="5" />
      <circle cx="440" cy="120" r="5" />
      <circle class="acc" cx="440" cy="40" r="6" style="animation-delay:-2.1s" />
      <circle cx="60" cy="300" r="5" />
      <circle cx="520" cy="420" r="5" />
      <circle cx="300" cy="560" r="5" />
      <circle class="acc" cx="520" cy="620" r="5.5" style="animation-delay:-0.6s" />
    </svg>
    <div class="wrap hero-grid">
      <div class="hero-left">
        <div class="lab hero-fade"><b>●</b> Meme coin · Open source · Soon on CEX</div>
        <h1 data-split style="margin-top:20px">Craft the <span class="acc glitch" data-text="coin.">coin.</span><br />Own the code.</h1>
        <p class="lead hero-fade" style="margin:20px 0 24px">COIN CRAFT is the gateway to open-source tools for artists on GitHub. Owned by the community, free to fork forever.</p>
        <div class="cta hero-fade">
          <a class="btn p" data-mag href="/buy">Join the launch Buy now<Icon name="arrow-up-right" size={15} /></a>
          <a class="btn" data-mag href="https://github.com/storytold" target="_blank" rel="noopener"><Icon name="github" size={16} /> Open source on GitHub</a>
        </div>
        <div class="cta hero-fade" style="margin-top:28px"><span class="chip">No subscription</span><span class="chip">Pure Rust apps</span><span class="chip">macOS · Windows · Linux</span></div>
        <div class="ca hero-fade" style="margin-top:12px"><span>Contract:</span>{caStated ? <span id="ca">{caValue}</span> : <span id="ca" class="mut">pending</span>}{caStated ? <button id="copy" type="button">Copy</button> : <button id="copy" type="button" disabled class="is-inert">Copy</button>}</div>
      </div>
      <div class="hero-right hero-fade">
        <Terminal />
      </div>
    </div></header>

  <Marquee />

  <section class="sec"><div class="wrap">
    <div class="lab rv">Explore</div>
    <h2 data-split>Everything in one craft.</h2>
    <div class="three">
      {cards.map((c) => <a class="card rv" href={c.href}><span class="k">{c.k}</span><h3>{c.t}</h3><p>{c.p}</p></a>)}
    </div>
    <div class="lab rv" style="margin-top:40px;margin-bottom:16px">Live market · Solana</div>
    <div class="livestats" id="live-stats">
      <div class="stat rv"><strong id="live-price">—</strong><span class="lab">Price (USD)</span></div>
      <div class="stat rv"><strong id="live-change">—</strong><span class="lab">24h change</span></div>
      <div class="stat rv"><strong id="live-volume">—</strong><span class="lab">Volume 24h</span></div>
      <div class="stat rv"><strong id="live-liq">—</strong><span class="lab">Liquidity</span></div>
      <div class="stat rv"><strong id="live-slot">—</strong><span class="lab">Chain slot</span></div>
    </div>
    <p class="lead" style="max-width:60ch;margin:24px auto 0;font-size:13px" id="live-note">Figures come from outside feeds as received. None of this is advice of any kind.</p>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="lab rv">Why now</div>
    <h2 data-split>Built for the next wave of creators.</h2>
    <p class="lead rv">Open-source tools, a community-owned coin, and a clear path from genesis to listings. The pieces are in place — the upside is in the execution.</p>
    <div class="three" style="margin-top:40px">
      <div class="card rv"><span class="k">01</span><h3>Open source edge</h3><p>Every app is public on GitHub. Auditable code, forkable, no lock-in. Trust compounds.</p></div>
      <div class="card rv"><span class="k">02</span><h3>Community owned</h3><p>Holders shape the roadmap. Bounties, votes, and a gallery of work made with Craft apps.</p></div>
      <div class="card rv"><span class="k">03</span><h3>Listing momentum</h3><p>Binance, OKX and Bybit are targets. Each confirmed listing is announced the moment it's official.</p></div>
    </div>
    <div class="stats" style="margin-top:48px">
      <div class="stat rv"><strong data-n="16" data-s="">16</strong><span class="lab">Open-source apps</span></div>
      <div class="stat rv"><strong data-n="3" data-s="">3</strong><span class="lab">OS platforms</span></div>
      <div class="stat rv"><strong data-n="0" data-s="">0</strong><span class="lab">Subscriptions</span></div>
      <div class="stat rv"><strong data-n="100" data-s="%">100%</strong><span class="lab">Community owned</span></div>
    </div>
    <div class="cta rv" style="margin-top:40px;justify-content:center">
      <a class="btn p" data-mag href="/buy">Get in early <Icon name="arrow-up-right" size={15} /></a>
      <a class="btn" data-mag href="/listings">View listings <Icon name="arrow-right" size={15} /></a>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="lab rv">How it works</div>
    <h2 data-split>Three steps to freedom.</h2>
    <div class="steps">
      {steps.map((s) => (
        <div class="step rv">
          <span class="n">{s.k}</span>
          <span class="ico"><Icon name={s.icon} size={20} /></span>
          <h3>{s.t}</h3>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </div></section>

  <Faq />
  <Cta />
</Base>
<script>
  import "../scripts/market.ts";
</script>
<script>
  document.getElementById("copy")?.addEventListener("click", async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const text = document.getElementById("ca")?.textContent ?? "";
    try {
      if (navigator.clipboard) await navigator.clipboard.writeText(text);
      b.textContent = "Copied";
    } catch {
      b.textContent = "Copy failed";
    }
    setTimeout(() => (b.textContent = "Copy"), 1400);
  });
</script>
